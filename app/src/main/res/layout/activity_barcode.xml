<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/app_background"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏷️ ระบบสร้างบาร์โค้ดสินค้า"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#5A3E2B"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etBarcodeCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="กรอกรหัสบาร์โค้ด (เช่น 8851234)"
        android:background="@drawable/rounded_header_bg"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnGenerate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="สร้างและพิมพ์บาร์โค้ด"
        android:padding="12dp"
        android:layout_marginBottom="24dp"/>

    <ImageView
        android:id="@+id/ivBarcodeResult"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:scaleType="fitCenter"
        android:background="#FFFFFF"/>

</LinearLayout>
