<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">\n    <uses-permission android:name="android.permission.CAMERA" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/app_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaYaiOnPOS">

        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SellScreen" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".StockScreen" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".HistoryScreen" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".ManageStoreScreen" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".BarcodeScreen" android:screenOrientation="portrait" android:exported="false" />
        <activity android:name=".ReportScreen" android:screenOrientation="portrait" android:exported="false" />
    </application>
</manifest>
