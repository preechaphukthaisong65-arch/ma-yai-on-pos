<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions สำหรับบลูทูธและการแจ้งเตือน -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_full_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.StockProPOS"
        tools:targetApi="31">

        <!-- หน้าจอหลักหรือ Activity อื่นๆ (ตัวอย่าง) -->
        <!-- <activity android:name=".MainActivity" ... /> -->

        <!-- หน้าจอจัดการบัญชีเครดิต (ล็อกแนวตั้ง) -->
        <activity
            android:name=".CreditAccountScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- หน้าจอประวัติการชำระเงินเครดิต (ล็อกแนวตั้ง) -->
        <activity
            android:name=".CreditPaymentHistoryScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

    </application>

</manifest>
