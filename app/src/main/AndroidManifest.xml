<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- สิทธิ์ใช้งานกล้องสำหรับสแกนบาร์โค้ด -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:label="ร้านแม่ใหญ่อ่อน POS"
        android:icon="@mipmap/app_icon"
        android:roundIcon="@mipmap/app_icon"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- หน้ารายงานยอดขาย -->
        <activity
            android:name=".ReportScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- หน้าจัดการลูกค้า -->
        <activity
            android:name=".ManageScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- หน้าประวัติการขาย -->
        <activity
            android:name=".HistoryScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- หน้าสร้างและแสดงบาร์โค้ด -->
        <activity
            android:name=".BarcodeScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- หน้าคลังสินค้า -->
        <activity
            android:name=".StockScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- หน้าขายสินค้า -->
        <activity
            android:name=".SellScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- หน้าระบบเครื่องพิมพ์ -->
        <activity
            android:name=".PrinterScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- หน้าหลักของแอป -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
