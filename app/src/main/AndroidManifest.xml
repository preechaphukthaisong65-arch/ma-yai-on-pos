
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_full_rules"
        android:icon="@mipmap/app_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.StockProPOS"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SellScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".StockScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".StocktakeScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".StockProductListScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".BarcodeScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".BarcodeLibraryScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".ReportScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".CreditAccountScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".CreditPaymentHistoryScreen"
            android:screenOrientation="portrait"
            android:exported="false" />

    </application>

</manifest>
